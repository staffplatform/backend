generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoreRole {
  OWNER
  MANAGER
  EMPLOYEE
}

enum ScheduleEntryType {
  SHIFT
  VACATION
  ABSENCE
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  firstName        String?
  middleName       String?
  lastName         String?
  birthDate        DateTime?
  avatarUrl        String?
  jobTitle         String?
  workCity         String?
  workAddress      String?
  companyAddress   String?
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  storeAssignments       StoreEmployee[]
  scheduleEntries        ScheduleEntry[]  @relation("EmployeeScheduleEntries")
  createdScheduleEntries ScheduleEntry[] @relation("ScheduleEntryCreatedBy")

  @@map("users")
}

model Store {
  id         String   @id @default(uuid())
  name       String
  city       String?
  address    String?
  activeFrom DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employees       StoreEmployee[]
  scheduleEntries ScheduleEntry[]

  @@map("stores")
}

model StoreEmployee {
  id        String    @id @default(uuid())
  storeId    String
  userId     String
  role       StoreRole @default(EMPLOYEE)
  activeFrom DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_employees")
}

model ScheduleEntry {
  id          String            @id @default(uuid())
  storeId      String
  userId       String
  date         DateTime         @db.Date
  type         ScheduleEntryType
  startTime    String?
  endTime      String?
  comment      String?
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User  @relation("EmployeeScheduleEntries", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User  @relation("ScheduleEntryCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([storeId, userId, date])
  @@index([storeId, date])
  @@index([userId, date])
  @@map("schedule_entries")
}
